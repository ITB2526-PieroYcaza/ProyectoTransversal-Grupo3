CREATE TRIGGER trg_audit_ins_usuaris_sistema AFTER INSERT ON `usuaris_sistema` FOR EACH ROW BEGIN
    INSERT INTO `taula_avisos` (`usuari_mysql`, `taula_afectada`, `operacio_intentada`, `descripcio_error`)
    VALUES (USER(), 'usuaris_sistema', 'INSERT', CONCAT('Usuario dado de alta: ', NEW.nom_complet, ' (', NEW.correu_electronic, ')'));
END //
CREATE TRIGGER trg_audit_upd_usuaris_sistema AFTER UPDATE ON `usuaris_sistema` FOR EACH ROW BEGIN
    INSERT INTO `taula_avisos` (`usuari_mysql`, `taula_afectada`, `operacio_intentada`, `descripcio_error`)
    VALUES (USER(), 'usuaris_sistema', 'UPDATE', CONCAT('Usuario modificado: ID ', OLD.id_usuari, '. Estado anterior: ', OLD.estat, ' -> Nuevo: ', NEW.estat));
END //
CREATE TRIGGER trg_audit_del_usuaris_sistema AFTER DELETE ON `usuaris_sistema` FOR EACH ROW BEGIN
    INSERT INTO `taula_avisos` (`usuari_mysql`, `taula_afectada`, `operacio_intentada`, `descripcio_error`)
    VALUES (USER(), 'usuaris_sistema', 'DELETE', CONCAT('Usuario eliminado del sistema: ', OLD.nom_complet, ' (', OLD.correu_electronic, ')'));
END //

DELIMITER ;
