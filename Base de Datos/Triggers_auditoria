-- ============================================================================
-- SCRIPT DE AUDITORÍA DE INTENTOS FALLIDOS POR PERMISOS (InnovateTech)
-- Basado en la matriz de roles y privilegios del sistema
-- ============================================================================

USE integrate_tech_db; -- Cambiar por tu base de datos si aplica

-- Limpieza de triggers de seguridad previos
DROP TRIGGER IF EXISTS trg_sec_empleats_ins;
DROP TRIGGER IF EXISTS trg_sec_nominas_ins;
DROP TRIGGER IF EXISTS trg_sec_clients_ins;
DROP TRIGGER IF EXISTS trg_sec_comandes_ins;
DROP TRIGGER IF EXISTS trg_sec_servidors_ins;

DELIMITER //

-- ============================================================================
-- 1. CONTROL DE RECURSOS HUMANOS (Solo permitido para 'cap_departament' o 'admin')
-- ============================================================================

CREATE TRIGGER trg_sec_empleats_ins
BEFORE INSERT ON `empleats`
FOR EACH ROW
BEGIN
    -- Si el usuario NO contiene 'cap_departament' ni 'admin' ni 'root' en su nombre de cuenta MySQL
    IF (CURRENT_USER() NOT LIKE '%cap_departament%' AND CURRENT_USER() NOT LIKE '%admin%' AND CURRENT_USER() NOT LIKE '%root%') THEN
        
        -- 1. Registramos de forma persistente el intento fallido por falta de privilegios
        INSERT INTO `taula_avisos` (`usuari_mysql`, `taula_afectada`, `operacio_intentada`, `descripcio_error`)
        VALUES (CURRENT_USER(), 'empleats', 'INSERT', 'ERROR: Intent d\'inserció no autoritzat per rols de recursos humans.');
        
        -- 2. Cancelamos la ejecución de la consulta para proteger la tabla
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Accés denegat: No tens permisos de Cap de Departament per modificar dades d\'empleats.';
    END IF;
END //

CREATE TRIGGER trg_sec_nominas_ins
BEFORE INSERT ON `nominas`
FOR EACH ROW
BEGIN
    IF (CURRENT_USER() NOT LIKE '%cap_departament%' AND CURRENT_USER() NOT LIKE '%admin%' AND CURRENT_USER() NOT LIKE '%root%') THEN
        INSERT INTO `taula_avisos` (`usuari_mysql`, `taula_afectada`, `operacio_intentada`, `descripcio_error`)
        VALUES (CURRENT_USER(), 'nominas', 'INSERT', 'ERROR: Intent de generació de nòmina rebutjat per falta de permisos.');
        
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Accés denegat: Gestió de nòmines restringida a Caps de Departament.';
    END IF;
END //


-- ============================================================================
-- 2. CONTROL DE NEGOCIO Y VENTAS (Solo permitido para 'administratiu' o 'admin')
-- ============================================================================

CREATE TRIGGER trg_sec_clients_ins
BEFORE INSERT ON `clients`
FOR EACH ROW
BEGIN
    -- Si el usuario NO contiene 'administratiu' ni es administrador del motor
    IF (CURRENT_USER() NOT LIKE '%administratiu%' AND CURRENT_USER() NOT LIKE '%admin%' AND CURRENT_USER() NOT LIKE '%root%') THEN
        
        INSERT INTO `taula_avisos` (`usuari_mysql`, `taula_afectada`, `operacio_intentada`, `descripcio_error`)
        VALUES (CURRENT_USER(), 'clients', 'INSERT', 'ERROR: Intent de creació de client bloquejat per violació de rols de negoci.');
        
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Accés denegat: Només el personal Administratiu pot gestionar la cartera de clients.';
    END IF;
END //

CREATE TRIGGER trg_sec_comandes_ins
BEFORE INSERT ON `comandes`
FOR EACH ROW
BEGIN
    IF (CURRENT_USER() NOT LIKE '%administratiu%' AND CURRENT_USER() NOT LIKE '%admin%' AND CURRENT_USER() NOT LIKE '%root%') THEN
        INSERT INTO `taula_avisos` (`usuari_mysql`, `taula_afectada`, `operacio_intentada`, `descripcio_error`)
        VALUES (CURRENT_USER(), 'comandes', 'INSERT', 'ERROR: Creació de comanda interceptada. Usuari no autoritzat.');
        
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Accés denegat: La facturació i creació de comandes requereix rol Administratiu.';
    END IF;
END //


-- ============================================================================
-- 3. CONTROL DE INFRAESTRUCTURA TÉCNICA (Solo permitido para 'tecnic' o 'admin')
-- ============================================================================

CREATE TRIGGER trg_sec_servidors_ins
BEFORE INSERT ON `servidors_videoconferencia`
FOR EACH ROW
BEGIN
    -- Si el usuario NO contiene 'tecnic' en su cuenta ni privilegios globales
    IF (CURRENT_USER() NOT LIKE '%tecnic%' AND CURRENT_USER() NOT LIKE '%admin%' AND CURRENT_USER() NOT LIKE '%root%') THEN
        
        INSERT INTO `taula_avisos` (`usuari_mysql`, `taula_afectada`, `operacio_intentada`, `descripcio_error`)
        VALUES (CURRENT_USER(), 'servidors_videoconferencia', 'INSERT', 'ERROR: Intent d\'alteració de la infraestructura de servidors Jitsi.');
        
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Accés denegat: Modificació de sistemes restringida exclusivament a Tècnics de xarxa.';
    END IF;
END //

DELIMITER ;
