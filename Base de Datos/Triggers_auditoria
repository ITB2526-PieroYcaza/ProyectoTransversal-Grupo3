CREATE TRIGGER trg_sec_empleats_ins BEFORE INSERT ON `empleats` FOR EACH ROW BEGIN
    IF (CURRENT_USER() NOT LIKE '%cap_departament%' AND CURRENT_USER() NOT LIKE '%admin%' AND CURRENT_USER() NOT LIKE '%root%') THEN
        INSERT INTO `taula_avisos` (`usuari_mysql`, `taula_afectada`, `operacio_intentada`, `descripcio_error`)
        VALUES (CURRENT_USER(), 'empleats', 'INSERT', 'ERROR PRIVILEGIS: Intent d\'inserció sense rol de Cap de Departament.');
        SET NEW.dni = NULL; -- Provoca fallo "Column cannot be null" salvando la auditoría
    END IF;
END //

