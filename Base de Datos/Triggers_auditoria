-- ============================================================================
-- SCRIPT DE AUDITORÍA NATIVA MEDIANTE GENERAL_LOG (Sin Plugins Externos)
-- ============================================================================

USE innovate_tech_db;

-- 1. Activamos el log general nativo de MySQL y le decimos que guarde en TABLA
SET GLOBAL general_log = 'ON';
SET GLOBAL log_output = 'TABLE';

-- 2. Limpiamos por si acaso
DROP TRIGGER IF EXISTS trg_capturar_intrusos_nativo;

DELIMITER //

-- 3. Creamos el TRIGGER sobre la tabla nativa de logs de MySQL
CREATE TRIGGER trg_capturar_intrusos_nativo
AFTER INSERT ON mysql.general_log
FOR EACH ROW
BEGIN
    -- Filtramos: si la query contiene un intento de alteración de datos (INSERT/UPDATE)
    -- y viene de uno de tus usuarios controlados (ej: vendes, tecnic, etc.)
    IF (NEW.argument LIKE '%INSERT INTO%' OR NEW.argument LIKE '%UPDATE%') 
       AND (NEW.user_host LIKE '%vendes%' OR NEW.user_host LIKE '%tecnic%' OR NEW.user_host LIKE '%administratiu%') THEN
        
        -- OJO: Como el general_log guarda la query antes de verificar si ha fallado o no,
        -- hacemos un truco de guardado selectivo para capturar el intento.
        INSERT INTO `innovate_tech_db`.`taula_avisos` 
        (
            `usuari_mysql`, 
            `taula_afectada`, 
            `operacio_intentada`, 
            `descripcio_error`
        )
        VALUES 
        (
            SUBSTRING_INDEX(NEW.user_host, '[', 1), -- Limpia el usuario para quitar la IP
            
            -- Detectamos la tabla que querían atacar
            CASE 
                WHEN NEW.argument LIKE '%empleats%' THEN 'empleats'
                WHEN NEW.argument LIKE '%nominas%' THEN 'nominas'
                WHEN NEW.argument LIKE '%clients%' THEN 'clients'
                WHEN NEW.argument LIKE '%servidors%' THEN 'servidors_videoconferencia'
                ELSE 'desconeguda'
            END,
            
            'INSERT',
            
            -- Guardamos la traza del delito
            CONCAT('AVÍS DE SEGURETAT: Intent d\'accés interceptat a la capa de xarxa per la query: ', NEW.argument)
        );
        
    END IF;
END //

DELIMITER ;
